!/templates/shelter2238-v003/tileDepthTextureAssignments.txt
!/templates/shelter2228-grass/
/templates/shelter2228-grass/*
!/templates/shelter2228-grass/tileGeometry.txt

/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/checks.yml

