# Publish only the reviewed original tooling. Everything else is private by default.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/LICENSE
!/NOTICE.md
!/docs/
!/src/
!/tests/
!/templates/

/src/*
!/src/build_prototype.py
!/src/shelter_visual_fixes.py
!/src/package_manifest.py
!/src/ConvertShelterMap.java
!/src/MergeShelterEdges.java
!/src/ValidateShelterMap.java
!/src/ConvertShelterAncillary.java
!/src/ValidateShelterMetadata.py
!/src/ShelterCell.java
!/src/ShelterParking.lua
!/src/RestoreLegacyGrass.java

/tests/*
!/tests/test_package_manifest.py

/templates/*
!/templates/shelter2238-v003/
/templates/shelter2238-v003/*
